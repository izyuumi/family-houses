{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-houses",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "family-houses"
    }
  ],
  "routes": [
    {
      "pattern": "iz.yumi.to",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://iz.yumi.to",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuaXoueXVtaS50byQ",
    "NEXT_PUBLIC_CONVEX_URL": "https://avid-swordfish-221.convex.cloud"
  },
  "secrets": {
    "required": ["CLERK_SECRET_KEY"]
  },
  "observability": {
    "enabled": true
  }
}
